# ============================================================
# AstorAI 环境变量样例
# 复制为 apps/web/.env.local 后填入真实值
# ⚠️ .env.local 已在 .gitignore 中，切勿提交
# ============================================================

# ---------- 站点 ----------
NEXT_PUBLIC_SITE_URL=https://astorai.cn

# ---------- Agent 模型 provider ----------
# 可选: zhipu | deepseek | openai | mock
# mock = 本地返回假流，用于前端联调，无需 API Key
ASTOR_MODEL_PROVIDER=mock

# ---------- 智谱 GLM（推荐，境内备案）----------
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ASTOR_MODEL=glm-4-plus

# ---------- DeepSeek（备选）----------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---------- 合规白名单 ----------
# 逗号分隔。不在白名单内的模型，运行时直接拒绝调用。
# 这是「境内备案模型」合规约束的代码化实现。
ASTOR_ALLOWED_MODELS=glm-4-plus,glm-4-air,deepseek-chat,deepseek-reasoner

# ---------- 支付（后期接入）----------
ASTOR_PAY_PROVIDER=mock
WECHAT_PAY_MCH_ID=
ALIPAY_APP_ID=
