# ============================================================
# AstorAI — Nginx 反向代理
#
# 部署时会把 __DOMAIN__ 替换成实际域名
# ⚠️ SSE（/api/astor/stream）部分的关键参数不能删，
#    删掉会导致流式输出被 Nginx 缓冲，表现为「等很久然后一次全出」
# ============================================================

upstream astorai_app {
    server 127.0.0.1:3000;
    keepalive 32;
}

# ---------- HTTP：仅用于 ACME 验证 + 跳转 HTTPS ----------
server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__ www.__DOMAIN__;

    # ACME 证书验证必须走 HTTP，不能跳
    location /.well-known/acme-challenge/ {
        root /var/www/html;
        allow all;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ---------- HTTPS ----------
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name __DOMAIN__ www.__DOMAIN__;

    # ---- SSL 证书（certbot 申请后填入）----
    ssl_certificate     /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;

    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    # ---- 安全响应头 ----
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # ---- 上传限制（问卷附件）----
    client_max_body_size 10m;

    # ---- 压缩 ----
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/json application/javascript
               text/xml application/xml image/svg+xml;

    # ---- 静态资源：Next.js 指纹文件，可长期缓存 ----
    location /_next/static/ {
        proxy_pass http://astorai_app;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_cache_valid 200 30d;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # ---- SSE 流式端点 ----
    # ⚠️ 以下四个参数是 SSE 生效的前提，不可删除
    location = /api/astor/stream {
        proxy_pass http://astorai_app;
        proxy_http_version 1.1;

        proxy_set_header Connection '';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_buffering off;          # 关闭缓冲 — 关键
        proxy_cache off;               # 关闭缓存 — 关键
        chunked_transfer_encoding on;
        proxy_read_timeout 300s;       # 长连接超时
        proxy_send_timeout 300s;

        add_header X-Accel-Buffering no always;   # 双重保险
    }

    # ---- 问卷提交 ----
    location = /api/survey/submit {
        proxy_pass http://astorai_app;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # ---- 其余全部转发 ----
    location / {
        proxy_pass http://astorai_app;
        proxy_http_version 1.1;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_read_timeout 60s;
    }
}
