# ─── Astor Web 环境变量示例 ───────────────────────────────────────
# 复制: cp .env.example .env, 填真实值
# Vercel: 在 Project → Settings → Environment Variables 设置同样的键

# PostgreSQL 连接串 (Neon 免费档 → https://neon.tech → 创建项目 → 复制 Pooled connection)
# 形如: postgresql://USER:PASS@ep-xxx-pooler.xxx.neon.tech/neondb?sslmode=require
DATABASE_URL=

# 直连 URL (Prisma migrate 用, 不用 pooler)。Neon: 同一个项目里有 "Direct" 模式。
DATABASE_DIRECT_URL=

# IP 哈希盐 (survey 提交时用 SHA256(盐+ip), 不存明文 IP)
IP_HASH_SALT=astor-demo-salt

# 强制禁用 DB (调试用, 即使设置了 DATABASE_URL 也走 mock)
# DISABLE_DB=1